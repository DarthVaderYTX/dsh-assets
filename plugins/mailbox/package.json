{
  "name": "mailbox",
  "version": "0.1.0",
  "private": true,
  "description": "In-harness mailbox: multiple IMAP accounts (same address twice included) plus QR sign-in for Feishu and Microsoft 365, IMAP IDLE alerts with a chime, and send/receive with attachments without leaving the panel.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "assets/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
