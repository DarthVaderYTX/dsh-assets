{
  "name": "dsh-autoeval",
  "version": "2.1.0",
  "private": true,
  "description": "AutoEval: a four-stage evaluation pipeline (Scraping, Annotation, Metrics, Reporting) with preset and custom execution for every stage, reachable from a left-sidebar panel.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "yaml.js",
    "xlsx.js",
    "importers.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "test/small-set.json",
    "test/fixtures/queries.xlsx"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
