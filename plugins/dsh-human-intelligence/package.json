{
  "name": "dsh-human-intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "HumanIntelligence — a multi-modal data annotation workbench for text, image, and video data.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "src/host/**/*.js"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
