{
  "name": "aether",
  "version": "1.0.0",
  "private": true,
  "description": "Aether: a DAG task execution manager with a left-sidebar panel for reusable modules (with input/output ports), pannable experiment DAGs and subgraphs, and submitted runs.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "constants.js",
    "seed.js",
    "http.js",
    "dag.js",
    "executor.js",
    "client.js",
    "client/src",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check",
    "test": "node --test test"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
